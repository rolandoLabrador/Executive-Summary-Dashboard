# Copy this file to .env and replace the placeholder values.
MONGO_URI="mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority"

# MongoDB source names
CONTRACT_DB=ContractDataDB
CONTRACT_COLLECTION=ContractData
CANCEL_DB=CancelDataDB
CANCEL_COLLECTION=CancelData
CLAIM_DB=ClaimDataDB
CLAIM_COLLECTION=ClaimData_Claim
AUDIT_DB=AuditDB
AUDIT_COLLECTION=DataReconciliationAudit

# Materialized Web Snapshot for Next.js Portal Ingestion
MONGODB_SNAPSHOT_COLLECTION=executive_report_snapshots

# Report settings
REPORT_COMPANY_NAME=OMNISHIELD
REPORT_OUTPUT_DIR=output
LOSS_RATIO_WARNING=0.65
LOSS_RATIO_HIGH=0.80
TOP_DEALER_COUNT=20

# Component codes to exclude in addition to the built-in dealer/commission rules.
EXCLUDED_COMPONENT_CODES=

# Optional SendGrid delivery
EMAIL_ENABLED=false
SENDGRID_API_KEY=SG.your_sendgrid_key
EMAIL_FROM=no-reply@omnishieldwarranty.com
EMAIL_TO=executive@omnishield.com
EMAIL_CC=

# AI Analyst Integration (Choose Gemini or OpenAI)
GEMINI_API_KEY=AIzaSy...your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Debug Mode: Triggers deep audit tabs and places the AI Analyst Lab as TAB #1
# DEBUG_DEALER_NAME=MS370
# DEBUG_AGENT_NAME=EXW

